{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker name configured in the Cloudflare dashboard (Workers Builds).
	"name": "portfoliowebsite",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding: "service" must equal "name" above.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "portfoliowebsite"
		}
	],
	"images": {
		// See https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}

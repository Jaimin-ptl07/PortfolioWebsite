# Canonical production URL (no trailing slash). Used for canonical links,
# Open Graph URLs, sitemap.xml and robots.txt. Leave unset for local dev.
NEXT_PUBLIC_SITE_URL=

# Optional: set to 1 to fetch public repositories from the GitHub REST API at
# build time (revalidated hourly). When unset, only the repositories listed
# manually in src/config/site.ts are shown.
GITHUB_REPOS_LIVE=

# Optional: a fine-grained GitHub token with no scopes (public data only) to
# raise the API rate limit. Server-side only — never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
